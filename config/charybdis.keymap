#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <250>;
    flavor = "balanced";
    quick-tap-ms = <175>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        kusr: kusr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp BACKSPACE>,
                <&macro_wait_time 2000>,
                <&kp LS(G) &kp R &kp E &kp E &kp N &kp A &kp T &kp O &kp M &kp N2 &kp N0 &kp N2 &kp N0>,
                <&macro_wait_time 1000>,
                <&kp RET>;

            label = "KUSR";
        };

        kurs_ip: kurs_ip {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp N1 &kp N9 &kp N2 &kp DOT &kp N1 &kp N6 &kp N8 &kp DOT &kp N1 &kp DOT &kp N1 &kp N7 &kp N4>,
                <&macro_wait_time 1000>,
                <&kp ENTER>;

            label = "KURS_IP";
        };

        basePWRD: basePWRD {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LS(G) &kp H &kp B &kp D &kp T &kp N &kp C &kp T &kp V &kp M &kp T &kp N3 &kp N2 &kp N1>,
                <&macro_wait_time 250>,
                <&kp ENTER>;

            label = "BASEPWRD";
        };

        outlookPSWD: outlookPSWD {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LS(W) &kp O &kp R &kp E &kp N1 &kp N0 &kp MINUS &kp LS(H) &kp I &kp L &kp L &kp MINUS &kp L &kp E &kp D &kp N6>,
                <&macro_wait_time 500>,
                <&kp ENTER>;

            label = "OUTLOOKPSWD";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp ESC         &mt LS(NUMBER_1) NUMBER_1  &mt LS(N2) NUMBER_2  &mt LS(N3) NUMBER_3  &mt LS(N4) NUMBER_4  &mt LS(N5) N5    &mt LS(N6) NUMBER_6  &mt LS(N7) N7        &mt LS(N8) N8  &mt LS(N9) N9  &mt LS(N0) N0        &kp BACKSPACE
&kp ESC         &kp Q                      &kp W                &kp E                &kp R                &kp T            &kp Y                &kp U                &kp I          &kp O          &kp P                &kp LEFT_BRACKET
&kp TAB         &kp A                      &kp S                &kp D                &kp F                &kp G            &kp H                &kp J                &kp K          &kp L          &kp SEMI             &kp APOS
&kp LEFT_SHIFT  &kp Z                      &kp X                &kp C                &mt LG(V) V          &lt 4 B          &kp N                &mt RIGHT_BRACKET M  &lt 4 COMMA    &kp DOT        &mt RA(SLASH) SLASH  &kp RIGHT_SHIFT
                                                                &kp LCTRL            &kp LEFT_WIN         &kp LEFT_ALT     &kp RIGHT_ALT        &mo 2
                                                                                     &mo 1                &kp SPACE        &kp ENTER
            >;
        };

        Lower {
            bindings = <
&kp F1       &kp F2  &kp F3        &kp F4     &kp F5         &kp F6          &kp F7           &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&kp LS(F12)  &none   &none         &kp UP     &kp LC(F3)     &kp LC(Y)       &kp PAGE_UP      &kp N7  &kp N8  &kp N9   &none    &none
&kp LS(F7)   &none   &kp LEFT      &kp DOWN   &kp RIGHT      &kp LS(LALT)    &kp PAGE_DOWN    &kp N4  &kp N5  &kp N6   &none    &none
&kp LSHFT    &none   &kp LC(LEFT)  &none      &kp LC(RIGHT)  &kp DEL         &kp PRINTSCREEN  &kp N1  &kp N2  &kp N3   &kp DOT  &kp RSHFT
                                   &mkp LCLK  &mkp MCLK      &mkp RCLK       &none            &kp N0
                                              &none          &none           &mo 6
            >;
        };

        Raise {
            bindings = <
&none      &none     &kp LS(AT)     &kp LS(DLLR)   &kp LS(POUND)  &none           &none          &none         &kp LS(CARET)  &none         &kp C_VOL_UP  &kp C_VOL_DN
&none      &none     &kp LS(COMMA)  &kp EQUAL      &kp LS(DOT)    &kp GRAVE       &none          &kp LBKT      &kp LS(UNDER)  &kp RBKT      &none         &kp K_MUTE
&none      &kp BSLH  &kp LS(LPAR)   &kp MINUS      &kp LS(RPAR)   &kp LS(PLUS)    &kp LS(PRCNT)  &kp LS(LBRC)  &kp SEMI       &kp LS(RBRC)  &kp LS(EXCL)  &none
&kp LSHFT  &none     &kp LS(STAR)   &kp LS(COLON)  &kp FSLH       &none           &none          &kp LS(PIPE)  &kp LS(TILDE)  &kp LS(AMPS)  &none         &kp RSHFT
                                    &none          &none          &none           &none          &none
                                                   &none          &mo 6           &none
            >;
        };

        Mouse {
            bindings = <
&mkp MB4     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &mkp MB4
&none        &none         &none         &mkp MCLK     &none      &none         &none       &none      &mkp MCLK     &none         &none         &none
&none        &none         &mkp RCLK     &mo 5         &mkp LCLK  &none         &none       &mkp LCLK  &mo 5         &mkp RCLK     &none         &none
&bootloader  &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &bootloader
                                         &mkp LCLK     &mkp MCLK  &mkp RCLK     &mkp MCLK   &mkp LCLK
                                                       &none      &none         &mkp RCLK
            >;
        };

        Snipper {
            bindings = <
&mkp MB4     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &mkp MB4
&none        &none         &none         &mkp MCLK     &none      &none         &none       &none      &mkp MCLK     &none         &none         &none
&none        &none         &mkp RCLK     &mo 5         &mkp LCLK  &none         &none       &mkp LCLK  &mo 5         &mkp RCLK     &none         &none
&bootloader  &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &bootloader
                                         &mkp LCLK     &mkp MCLK  &mkp RCLK     &mkp MCLK   &mkp LCLK
                                                       &none      &none         &mkp RCLK
            >;
        };

        Scroll {
            bindings = <
&none        &none  &none  &none  &none      &none        &none  &none  &none  &none  &none  &none
&none        &none  &none  &none  &none      &none        &none  &none  &none  &none  &none  &none
&none        &none  &none  &none  &none      &none        &none  &none  &none  &none  &none  &none
&bootloader  &none  &none  &none  &none      &none        &none  &none  &none  &none  &none  &bootloader
                           &none  &none      &none        &none  &none
                                  &mkp LCLK  &mkp RCLK    &none
            >;
        };

        Ajust {
            bindings = <
&basePWRD  &none  &none  &none  &none  &kusr       &outlookPSWD    &none  &none         &none         &none         &none
&none      &none  &none  &none  &none  &none       &bt BT_CLR      &none  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none      &none  &none  &none  &none  &none       &none           &none  &none         &none         &none         &none
&none      &none  &none  &none  &none  &kurs_ip    &studio_unlock  &none  &none         &none         &none         &kp INSERT
                         &none  &none  &none       &none           &none
                                &none  &none       &none
            >;
        };
    };
};
