#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp ESC         &mt LS(NUMBER_1) NUMBER_1  &mt LS(N2) NUMBER_2  &mt LS(N3) NUMBER_3  &mt LS(N4) NUMBER_4  &mt LS(N5) N5    &mt LS(N6) NUMBER_6  &mt LS(N7) N7        &mt LS(N8) N8  &mt LS(N9) N9  &mt LS(N0) N0        &kp BACKSPACE
&kp ESC         &kp Q                      &kp W                &kp E                &kp R                &kp T            &kp Y                &kp U                &kp I          &kp O          &kp P                &kp LEFT_BRACKET
&kp TAB         &kp A                      &kp S                &kp D                &kp F                &kp G            &kp H                &kp J                &kp K          &kp L          &kp SEMI             &kp APOS
&kp LEFT_SHIFT  &kp Z                      &kp X                &kp C                &mt LG(V) V          &lt 3 B          &lt 3 N              &mt RIGHT_BRACKET M  &kp COMMA      &kp DOT        &mt RA(SLASH) SLASH  &kp RIGHT_SHIFT
                                                                &kp LCTRL            &kp LEFT_ALT         &kp LEFT_WIN     &kp RIGHT_ALT        &kp ENTER
                                                                                     &mo 1                &kp SPACE        &mo 2
            >;
        };

        Lower {
            bindings = <
&kp F1       &kp F2  &kp F3        &kp F4    &kp F5         &kp F6          &kp F7           &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&kp LS(F12)  &none   &none         &kp UP    &kp LC(F3)     &kp LC(Y)       &kp PAGE_UP      &kp N7  &kp N8  &kp N9   &none    &none
&kp LS(F7)   &none   &kp LEFT      &kp DOWN  &kp RIGHT      &kp LS(LALT)    &kp PAGE_DOWN    &kp N4  &kp N5  &kp N6   &none    &none
&kp LSHFT    &none   &kp LC(LEFT)  &none     &kp LC(RIGHT)  &kp DEL         &kp PRINTSCREEN  &kp N1  &kp N2  &kp N3   &kp DOT  &kp RSHFT
                                   &trans    &trans         &trans          &none            &kp N0
                                             &none          &none           &mo 3
            >;
        };

        Raise {
            bindings = <
&kp F12        &kp F1      &kp F2      &kp F3         &kp F4         &kp F5          &kp F6             &kp F7         &kp F8    &kp F9     &kp F10  &kp F11
&kp LS(GRAVE)  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)     &kp LS(N4)     &kp LS(LBKT)    &kp LS(RBKT)       &none          &none     &none      &none    &none
&kp LSHFT      &kp LS(N5)  &kp LS(N6)  &kp LS(N7)     &kp LS(N8)     &none           &kp LS(BACKSLASH)  &none          &kp UP    &none      &none    &none
&kp LCTRL      &kp LS(N9)  &kp LS(N0)  &kp LS(MINUS)  &kp LS(EQUAL)  &none           &none              &kp LEFT       &kp DOWN  &kp RIGHT  &none    &none
                                       &kp LEFT_WIN   &kp SPACE      &kp ENTER       &trans             &kp RIGHT_ALT
                                                      &none          &none           &none
            >;
        };

        Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none           &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR      &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &none         &none         &mkp MCLK     &none      &none         &none           &none      &mkp MCLK     &none         &none         &none
&bootloader  &none         &mkp RCLK     &mo 4         &mkp LCLK  &none         &studio_unlock  &mkp LCLK  &mo 4         &mkp RCLK     &none         &bootloader
                                         &none         &mkp LCLK  &mkp RCLK     &mkp RCLK       &mkp LCLK
                                                       &none      &none         &none
            >;
        };

        Scroll {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &none         &none         &mkp MCLK     &none      &none         &none       &none      &mkp MCLK     &none         &none         &none
&bootloader  &none         &mkp RCLK     &none         &mkp LCLK  &none         &none       &mkp LCLK  &none         &mkp RCLK     &none         &bootloader
                                         &none         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &none         &none
            >;
        };
    };
};
